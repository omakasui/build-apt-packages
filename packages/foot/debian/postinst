#!/bin/sh
# postinst for foot

set -e

case "$1" in
    configure)
        # Register foot and footclient as x-terminal-emulator alternatives.
        update-alternatives --install /usr/bin/x-terminal-emulator \
            x-terminal-emulator /usr/bin/foot 50 \
            --slave /usr/share/man/man1/x-terminal-emulator.1.gz \
            x-terminal-emulator.1.gz /usr/share/man/man1/foot.1.gz \
            2>/dev/null || true
        update-alternatives --install /usr/bin/x-terminal-emulator \
            x-terminal-emulator /usr/bin/footclient 10 \
            --slave /usr/share/man/man1/x-terminal-emulator.1.gz \
            x-terminal-emulator.1.gz /usr/share/man/man1/footclient.1.gz \
            2>/dev/null || true

        # The Debian foot package enables foot-server for every user; this
        # package leaves it to the user (systemctl --user enable).
        if [ -z "$DPKG_ROOT" ] && [ -x /usr/bin/deb-systemd-helper ]; then
            deb-systemd-helper --user purge \
                foot-server.service foot-server.socket >/dev/null || true
        fi
        ;;
esac

exit 0
